---
interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title,
  description = "Hosted Model Context Protocol (MCP) server for Developer Relations (DevRel) activity reporting and content analytics across Google GDE (Advocu), Microsoft MVP, AWS Community Builders, Docker Captains, YouTube, Dev.to, Hashnode, and GitHub.",
  canonicalPath = "/",
} = Astro.props;

const siteUrl = "https://devrel.codingcat.dev";
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "DevRel MCP by CodingCat.dev",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Cloudflare Workers, macOS, Linux, Windows",
      "url": siteUrl,
      "description": description,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
      },
      "author": {
        "@type": "Organization",
        "name": "CodingCat.dev",
        "url": "https://codingcat.dev",
      },
      "featureList": [
        "Google Developer Experts (GDE) Advocu activity draft submission (7 tools)",
        "Microsoft MVP activity reporting for Videos, Blogs, Speaking, and Books (4 tools)",
        "YouTube Data API v3, Dev.to, Hashnode, and GitHub analytics auto-fetching",
        "AWS Community Builders, Docker Captains, Cypress Ambassadors, and custom Advocu program support",
        "MCP OAuth 2.1 with Dynamic Client Registration, PKCE S256, and per-user AES-256-GCM encrypted Cloudflare D1 storage",
        "Email Magic Link, Email OTP, CLI Terminal Link Login, and GitHub OAuth",
      ],
    },
    {
      "@type": "WebAPI",
      "name": "DevRel MCP Streamable HTTP Endpoint",
      "description": "OAuth 2.1 protected Model Context Protocol (MCP) Streamable HTTP endpoint for AI agents (Claude, Cursor, Windsurf, ChatGPT).",
      "documentation": `${siteUrl}/docs`,
      " endpointURL": `${siteUrl}/mcp`,
      "termsOfService": `${siteUrl}/docs`,
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is DevRel MCP (devrel.codingcat.dev)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "DevRel MCP is a hosted Model Context Protocol (MCP) platform on Cloudflare Workers and D1 that lets Developer Advocates, Google Developer Experts (GDEs), Microsoft MVPs, and AWS Community Builders automatically pull content metrics from YouTube, Dev.to, Hashnode, and GitHub and submit activity reports directly from Claude, Cursor, or any MCP-compatible AI assistant.",
          },
        },
        {
          "@type": "Question",
          "name": "How are my Advocu, Microsoft MVP, and API tokens secured?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every user's provider credentials are encrypted at rest in Cloudflare D1 using Web Crypto AES-256-GCM with a unique 12-byte IV and authenticated user-ID binding (AEAD additionalData). Credentials are only decrypted in-memory during an authenticated OAuth 2.1 MCP request and are never returned to the browser or shared between users.",
          },
        },
        {
          "@type": "Question",
          "name": "How do I connect Claude Code or Cursor to DevRel MCP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Add https://devrel.codingcat.dev/mcp as a Streamable HTTP MCP server in your client. Your client will automatically discover the OAuth 2.1 endpoints via /.well-known/oauth-protected-resource, open your browser to sign in with Email Magic Link, Email OTP, or GitHub, and prompt for explicit consent.",
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | DevRel MCP — CodingCat.dev</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" title="LLMs.txt" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="LLMs Full Documentation" href="/llms-full.txt" />

    <!-- OpenGraph / AEO Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | DevRel MCP`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="DevRel MCP by CodingCat.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | DevRel MCP`} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script src="/app.js" defer></script>

    <style is:global>
      :root {
        --bg: #0b0f19;
        --bg-card: #131b2e;
        --bg-input: #0f1626;
        --border: #26324d;
        --text: #f1f5f9;
        --text-muted: #94a3b8;
        --primary: #8b5cf6;
        --primary-hover: #7c3aed;
        --accent: #38bdf8;
        --success: #22c55e;
        --danger: #ef4444;
        --warning: #f59e0b;
        --radius: 10px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }

      .container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 1.5rem;
      }

      header.site-header {
        border-bottom: 1px solid var(--border);
        background: rgba(19, 27, 46, 0.85);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 20;
      }

      .nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        max-width: 1120px;
        margin: 0 auto;
        padding: 0.9rem 1.5rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--text);
      }

      .badge {
        display: inline-block;
        padding: 0.15rem 0.55rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 999px;
        background: rgba(139, 92, 246, 0.2);
        color: #c4b5fd;
        border: 1px solid rgba(139, 92, 246, 0.4);
      }

      .nav-links {
        display: flex;
        gap: 1.25rem;
        align-items: center;
        font-size: 0.95rem;
      }

      .card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }

      .grid-2 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.25rem;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
      }

      button, .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        background: var(--primary);
        color: #fff;
        font-weight: 600;
        font-size: 0.92rem;
        padding: 0.6rem 1.1rem;
        border: 1px solid transparent;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.15s ease;
      }
      button:hover, .btn:hover {
        background: var(--primary-hover);
        text-decoration: none;
      }
      button.secondary, .btn.secondary {
        background: transparent;
        border-color: var(--border);
        color: var(--text);
      }
      button.secondary:hover, .btn.secondary:hover {
        background: rgba(255, 255, 255, 0.05);
      }
      button.danger {
        background: rgba(239, 68, 68, 0.15);
        border-color: rgba(239, 68, 68, 0.4);
        color: #fca5a5;
      }
      button.danger:hover {
        background: rgba(239, 68, 68, 0.28);
      }

      .field {
        margin-bottom: 1rem;
      }

      label {
        display: block;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 0.2rem;
      }

      /* Modern Web Guidance: Place format hints above the input so autocomplete popovers don't cover them */
      .hint {
        display: block;
        color: var(--text-muted);
        font-size: 0.8rem;
        margin-bottom: 0.35rem;
      }

      input[type="text"],
      input[type="email"],
      input[type="password"],
      input[type="number"],
      input[type="url"] {
        width: 100%;
        padding: 0.6rem 0.75rem;
        border-radius: 7px;
        border: 1px solid var(--border);
        background: var(--bg-input);
        color: var(--text);
        font-size: 0.95rem;
      }

      /* Modern Web Guidance: Only show error styles after user interaction (:user-invalid) */
      input:user-invalid {
        border-color: var(--danger);
        background-color: rgba(239, 68, 68, 0.08);
      }

      .error-msg {
        display: none;
        color: #fca5a5;
        font-size: 0.82rem;
        margin-top: 0.25rem;
      }

      input:user-invalid + .error-msg {
        display: block;
      }

      input:user-valid {
        border-color: rgba(34, 197, 94, 0.6);
      }

      code, pre {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.88rem;
      }

      pre {
        background: #070a12;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem;
        overflow-x: auto;
      }

      .status-banner {
        padding: 0.75rem 1rem;
        border-radius: 8px;
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.3);
        margin-bottom: 1rem;
      }
      .status-banner:empty {
        display: none;
      }

      footer.site-footer {
        margin-top: 4rem;
        padding: 2rem 1.5rem;
        border-top: 1px solid var(--border);
        text-align: center;
        color: var(--text-muted);
        font-size: 0.88rem;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-bar" aria-label="Main Navigation">
        <a href="/" class="brand">
          <span>🐾 DevRel MCP</span>
          <span class="badge">OAuth 2.1 + D1</span>
        </a>
        <div class="nav-links">
          <a href="/">Dashboard</a>
          <a href="/docs">Documentation & Tools</a>
          <a href="/cli-auth">CLI Login</a>
          <a href="/llms.txt">llms.txt</a>
          <a href="https://github.com/CodingCatDev/devrel-mcp" target="_blank" rel="noopener">GitHub</a>
        </div>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        Built by <a href="https://codingcat.dev">CodingCat.dev</a> • Hosted on Cloudflare Workers & D1 •
        <a href="/llms.txt">LLMs.txt</a> • <a href="/llms-full.txt">LLMs-Full.txt</a> • <a href="/sitemap.xml">Sitemap</a>
      </p>
    </footer>
  </body>
</html>
