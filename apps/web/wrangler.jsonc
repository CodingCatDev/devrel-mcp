{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devrel-mcp",
  "account_id": "c46bd0f3b9ed47b8692cca098030edbf",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": {
    "BETTER_AUTH_URL": "https://devrel.codingcat.dev",
    "PUBLIC_SITE_URL": "https://devrel.codingcat.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devrel-mcp",
      "database_id": "88e72347-89a2-4ddd-9cb5-b049f93579f5",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "env": {
    "production": {
      "account_id": "c46bd0f3b9ed47b8692cca098030edbf",
      "routes": [
        {
          "pattern": "devrel.codingcat.dev",
          "custom_domain": true
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://devrel.codingcat.dev",
        "PUBLIC_SITE_URL": "https://devrel.codingcat.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devrel-mcp",
          "database_id": "88e72347-89a2-4ddd-9cb5-b049f93579f5",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "MCP_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 60, "period": 60 }
        }
      ]
    }
  },
  "observability": { "enabled": false }
}
