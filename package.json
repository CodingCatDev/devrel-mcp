{
  "name": "devrel-mcp-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "DevRel Activity Reporting & Analytics MCP Monorepo — Hosted on Cloudflare Workers + D1 + Astro at devrel.codingcat.dev",
  "author": "CodingCat.dev <alex@codingcat.dev> (https://codingcat.dev)",
  "contributors": [
    "Carlos Azaustre <cazaustre@gmail.com> (https://carlosazaustre.es/)",
    "Alan Buscaglia (https://gentleman.programming)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodingCatDev/devrel-mcp.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @codingcatdev/devrel-mcp build && pnpm --filter @codingcatdev/devrel-web build",
    "dev": "pnpm --filter @codingcatdev/devrel-web dev",
    "dev:stdio": "pnpm --filter @codingcatdev/devrel-mcp dev",
    "dev:hosted": "pnpm --filter @codingcatdev/devrel-web dev:hosted",
    "deploy": "pnpm build && pnpm --filter @codingcatdev/devrel-web deploy",
    "deploy:hosted": "pnpm deploy",
    "db:migrate:local": "pnpm --filter @codingcatdev/devrel-web db:migrate:local",
    "db:migrate:remote": "pnpm --filter @codingcatdev/devrel-web db:migrate:remote",
    "test": "pnpm test:hosted",
    "test:hosted": "pnpm build && pnpm --filter @codingcatdev/devrel-web test:hosted",
    "lint": "biome check .",
    "format": "biome format --write .",
    "auth-mvp": "pnpm --filter @codingcatdev/devrel-mcp auth-mvp",
    "capture-mvp-token": "pnpm --filter @codingcatdev/devrel-mcp capture-mvp-token"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.3",
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2"
  }
}
